---
import SiteLayout from '../layouts/SiteLayout.astro';
import database from '../../data/classes.json';
import '../styles/classes.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const skills: Record<string, string> = database.skills;
const groups = database.tiers.map((tier) => ({
  ...tier,
  classes: database.classes.filter((entry) => entry.tier === tier.id)
    .sort((a, b) => a.name.localeCompare(b.name)),
}));
const nintendo = database.sources.find((source) => source.id === 'nintendo')!;
---

<SiteLayout title="Classes" page="classes" description="Class skill ranks, certification levels, mastery abilities and unlock conditions in Fire Emblem Fortune's Weave.">
  <div class="page-heading classes-heading">
    <h1>Classes</h1>
    <a class="mount-art" href={nintendo.url} aria-label="View the original class mount artwork from Nintendo">
      <img src={`${base}/assets/classes/mounts.jpg`} alt="An ornius, a horse-drawn chariot, and an armored elephant." width="6000" height="1710" />
    </a>
  </div>

  <ol class="tier-overview" aria-label="Certification tier access">
    {groups.map((tier) => (
      <li>
        <a href={`#${tier.id}`}><span>{tier.name}</span><span class="tier-level">Lv. {tier.idealLevel}</span></a>
        <span class="tier-condition">Renown {tier.renown}<span aria-hidden="true"> · </span>{tier.license}</span>
      </li>
    ))}
  </ol>
  <p class="tier-note">Levels are recommended for exams. Certification lets you move between class lines. <a href="#certification">How it works</a></p>

  <div class="class-controls" id="class-controls" hidden>
    <div class="tier-filters" role="group" aria-label="Filter by class tier">
      <button type="button" data-tier="all" aria-pressed="true">All classes</button>
      {groups.map((tier) => <button type="button" data-tier={tier.id} aria-pressed="false">{tier.name}</button>)}
    </div>
    <div class="class-search-controls">
      <label class="route-filter"><span class="sr-only">Unlock conditions</span>
        <select id="class-route" aria-label="Unlock conditions">
          <option value="all">All unlock conditions</option>
          <option value="standard">No route quest</option>
          <option value="Cai">Cai</option>
          <option value="Dietrich">Dietrich</option>
          <option value="Leda">Leda</option>
          <option value="Theodora">Theodora</option>
        </select>
      </label>
      <label class="search">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m16 16 4.5 4.5" /></svg>
        <input id="class-query" type="search" placeholder="Find a class or skill…" aria-label="Search classes, skills, or unlock conditions" autocomplete="off" />
      </label>
    </div>
  </div>
  <p id="class-status" class="sr-only" role="status" aria-live="polite" aria-atomic="true"></p>

  <div id="class-catalogue">
    {groups.map((tier) => (
      <section class="class-group" id={tier.id} data-tier-group={tier.id} aria-labelledby={`${tier.id}-title`}>
        <div class="class-group-heading"><h2 id={`${tier.id}-title`}>{tier.name}</h2><span>Ideal Lv. {tier.idealLevel} / Renown {tier.renown}</span></div>
        <table class="class-table" aria-labelledby={`${tier.id}-title`}>
          <colgroup><col class="name-column" /><col class="ranks-column" /><col class="mastery-column" /><col class="unlock-column" /></colgroup>
          <thead><tr><th scope="col">Class</th><th scope="col">Skill ranks</th><th scope="col">Mastery</th><th scope="col">Unlock conditions</th></tr></thead>
          <tbody>
            {tier.classes.map((entry) => (
              <tr id={entry.id} data-class data-routes={entry.unlockRoutes.map(({ route }) => route).join(',')} data-standard={entry.unlock === 'Available with this tier.' ? 'true' : 'false'} data-aliases={entry.aliases.join(' ')}>
                <th scope="row"><span class="class-name">{entry.name}</span>{entry.restriction && <span class="class-restriction">{entry.restriction}</span>}</th>
                <td data-label="Skill ranks">
                  {entry.requirements ? <ul class="skill-ranks">{entry.requirements.map(({ skill, rank }) => <li><span>{skills[skill]}</span>{' '}<strong>{rank}</strong></li>)}</ul> : <span class="unverified">Not verified</span>}
                  {entry.licenseOverride && <span class="license-override">{entry.licenseOverride}</span>}
                </td>
                <td data-label="Mastery">
                  {entry.mastery ? <><span class="mastery-name">{entry.mastery.name}</span>{entry.mastery.effect && <span class="mastery-effect">{entry.mastery.effect}</span>}</> : <span class="unverified">Not verified</span>}
                </td>
                <td data-label="Unlock conditions">
                  {entry.unlockRoutes.length > 0 ? <ul class="unlock-routes">{entry.unlockRoutes.map((unlock) => <li><strong>{unlock.route}{unlock.chapter && <span> · Ch. {unlock.chapter}</span>}</strong><span>{unlock.text}</span></li>)}</ul> : <span class={entry.unlock === 'Available with this tier.' ? 'standard-unlock' : ''}>{entry.unlock}</span>}
                  {entry.notes.length > 0 && <details class="entry-notes"><summary>Source note</summary>{entry.notes.map((note) => <p>{note}</p>)}<p>{entry.sources.map((id, index) => { const source = database.sources.find((item) => item.id === id)!; return <>{index > 0 && ' / '}<a href={source.url}>{source.name.split(' — ')[0]}</a></>; })}</p></details>}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>
    ))}
  </div>
  <p id="class-empty" class="empty" hidden>No classes match these filters. <button type="button" id="clear-class-filters">Clear filters</button></p>

  <section class="class-guide" id="certification" aria-labelledby="certification-title">
    <h2 id="certification-title">Certification &amp; advancement</h2>
    <div class="guide-columns">
      <div class="guide-copy">
        <h3>Train, certify, reclass</h3>
        <p>Train the listed skills, buy the appropriate license, and take an exam with the proctor in Dagsion. Skill ranks and character level affect the displayed pass chance. A rank listed here is a training target, not a guarantee of success.</p>
        <p>A passed exam unlocks that class for the unit. Use Reclass to return to a class already earned. There is no mandatory Gladiator → Myrmidon → Shido chain.</p>
        <h3>Mastery is separate</h3>
        <p>Mastering a class earns its mastery ability. Check its equipment restrictions before carrying it into another class. You can return to finish a mastery later.</p>
        <p class="guide-citation"><a href={nintendo.url}>Nintendo</a> · <a href={database.sources.find((source) => source.id === 'fdaytalk')!.url}>Certification guide</a> · <a href={database.sources.find((source) => source.id === 'all-things-how')!.url}>Mastery guide</a></p>
      </div>
      <figure class="game-reference">
        <a href={`${base}/assets/classes/bardinger-exam.jpg`}><img src={`${base}/assets/classes/bardinger-exam.jpg`} alt="Bardinger certification screen: ideal level 35, Renown 8, Riding C, Spear B, and Sword B." width="1024" height="576" loading="lazy" /></a>
        <figcaption>Certification screen from the Nintendo Direct. <a href={database.sources.find((source) => source.id === 'serenes')!.url}>Via Serenes Forest</a></figcaption>
      </figure>
    </div>
    <details class="guide-disclosure" id="class-stats">
      <summary>Stats &amp; growth rates</summary>
      <div class="guide-columns disclosure-content">
        <div class="guide-copy"><p>The requirements above are weapon and movement skill ranks. They are not minimum Strength, Magic, or Speed stats.</p><p>The game shows a character's base growth rate and the class contribution separately. Nintendo's example shows Cai with 45% base Speed growth and a +10-point class modifier, for 55% total.</p><p>Full class base stats and growth modifiers are not yet verified in this database. Use the in-game comparison when choosing a class for a particular character.</p></div>
        <figure class="game-reference"><img src={`${base}/assets/classes/growth-rates.png`} alt="Nintendo's stat screen shows base Speed growth 45 plus class 10, totaling 55." width="750" height="434" loading="lazy" /><figcaption>Growth-rate example. <a href={nintendo.url}>Nintendo / Intelligent Systems</a></figcaption></figure>
      </div>
    </details>
    <details class="guide-disclosure" id="later-classes">
      <summary>Master &amp; Divine classes <span>Late-game spoilers</span></summary>
      <div class="later-tiers disclosure-content">
        {database.laterTiers.map((tier) => <section><h3>{tier.name}</h3>{tier.idealLevel && <p class="later-requirements">Ideal Lv. {tier.idealLevel} · {tier.license}</p>}<p>{tier.text}</p></section>)}
      </div>
      <p class="muted">The current guides do not establish a complete roster or individual requirements for these tiers. <a href={database.sources.find((source) => source.id === 'pocket-tactics')!.url}>Tier overview</a></p>
    </details>
    <details class="guide-disclosure" id="class-sources">
      <summary>Sources &amp; coverage <span>Checked 21 September 2026</span></summary>
      <div class="disclosure-content">
        <p>{database.coverage} Commoner and Noble are starting classes and are not included in the exam tables.</p>
        <p>Skill ranks do not list every weapon a class can equip. Route labels describe where an unlock is earned; they do not mean the class can only be used on that route. Unlocks can carry across routes.</p>
        <p>Source notes mark spelling differences, conflicting requirements, and incomplete records. These are guide-reported values, not an independently tested game database.</p>
        <ul class="source-list">{database.sources.map((source) => <li><a href={source.url}>{source.name}</a><span>{source.scope}</span></li>)}</ul>
        <p class="muted">Artwork and screenshots: Nintendo / Intelligent Systems. Original files and source URLs are recorded in the asset index.</p>
      </div>
    </details>
  </section>
  <script>import '../scripts/classes';</script>
</SiteLayout>
