---
import SiteLayout from '../../layouts/SiteLayout.astro';
import CaiGraphic from '../../components/characters/CaiGraphic.astro';
import CaiIdentity from '../../components/characters/CaiIdentity.astro';
import StatChart from '../../components/characters/StatChart.astro';
import PanelDecoration from '../../components/characters/PanelDecoration.astro';
import CaiReferenceStats from '../../components/characters/CaiReferenceStats.astro';
import cai from '../../../data/characters/cai.json';
import '../../styles/characters.css';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const screens = [
  { id: 'stats', label: 'Stats' },
  { id: 'arts', label: 'C.Arts/Magic' },
  { id: 'class', label: 'Class' },
  { id: 'unique', label: 'Unique Abilities' },
  { id: 'history', label: 'Personal History' },
];
const classLines = [
  { name: 'Gladiators', beginner: 'gladiator', specialty: 'gladiators', count: 3 },
  { name: 'Hunters', beginner: 'hunter', specialty: 'hunters', count: 2 },
  { name: 'Soldiers', beginner: 'soldier', specialty: 'soldiers', count: 3 },
  { name: 'Fliers', beginner: 'flier', specialty: 'fliers', count: 1 },
  { name: 'Mages', beginner: 'mage', specialty: 'mages', count: 2 },
] as const;
const marks: Record<string, string> = { sword: '⚔', shield: '⛨', speed: '≋', resistance: '♧', dexterity: '☼', luck: '✦', charm: '♡', spear: '↗', book: '▱' };
---
<SiteLayout title="Cai" page="characters" character canonicalPath="/characters/cai/" description="Cai, Child of Ribeira. Stats, combat arts, class, unique abilities, and personal history.">
  <div class="character-toolbar">
    <a class="back-to-characters" href={`${base}/characters/`}><span aria-hidden="true">‹</span> Characters</a>
    <div class="view-switch" role="group" aria-label="Character layout" hidden>
      <button type="button" data-character-view="panels" aria-pressed="true">Panels</button>
      <button type="button" data-character-view="all" aria-pressed="false">All information</button>
    </div>
  </div>
  <article class="character-panel" data-view="panels" aria-labelledby="character-name">
    <div class="panel-surface" aria-hidden="true"><PanelDecoration /></div>
    <svg class="panel-frame" viewBox="0 0 1840 980" preserveAspectRatio="none" fill="none" aria-hidden="true"><path d="M2 31H438L468 2H1372L1402 31H1838V978H2Z" /><path d="M9 39H441L472 10H1368L1399 39H1831V970H9Z" /></svg>
    <header class="character-title"><h1 id="character-name">{cai.name} <span>{cai.title}</span></h1></header>
    <nav class="all-section-nav" aria-label="Cai sections" hidden>
      {screens.map((screen) => <a href={`#${screen.id}`}>{screen.id === 'arts' ? 'Arts & Magic' : screen.label}</a>)}
      <a href="#starting-stats">Starting stats &amp; growth</a>
    </nav>

    <div class="character-screens">
      <section id="stats" class="character-screen stats-screen" role="tabpanel" aria-labelledby="tab-stats" tabindex="0">
        <header class="screen-heading"><h2 id="section-stats">Stats</h2><span>Lv. 5 capture</span></header>
        <div class="panel-column">
          <CaiIdentity />
          <div class="stat-section">
            <h2 class="panel-heading">Combat Stats</h2>
            <div class="stat-block">
              <dl class="stat-values">{cai.combatStats.map((stat) => <div><dt><span class="stat-symbol" aria-hidden="true">{marks[stat.icon]}</span>{stat.name}</dt><dd class:list={{ boosted: stat.boosted }}>{stat.value}{stat.boosted && <sup>▴</sup>}</dd></div>)}</dl>
              <StatChart type="combat" />
            </div>
          </div>
          <div class="stat-section">
            <h2 class="panel-heading">Basic Stats <span class="rating">Rating <strong class="boosted">{cai.rating}<sup>▴</sup></strong></span></h2>
            <div class="stat-block">
              <dl class="stat-values">{cai.basicStats.map((stat) => <div><dt><span class="stat-symbol" aria-hidden="true">{marks[stat.icon]}</span>{stat.name}</dt><dd class:list={{ boosted: stat.boosted }}>{stat.value}{stat.boosted && <sup>▴</sup>}</dd></div>)}</dl>
              <StatChart type="basic" />
            </div>
          </div>
        </div>
        <div class="panel-column">
          <h2 class="panel-heading">Equipped <span>Durability</span></h2>
          <div class="item-row"><CaiGraphic name="spear" /><span>Wooden Spear</span><strong>10/10</strong></div>
          <h2 class="panel-heading">Items <span>Durability</span></h2>
          <ul class="slot-list items">
            {cai.items.map((item) => <li class:list={['item-row', { 'inactive-item': item.inactive }]}><CaiGraphic name={item.graphic as 'spear' | 'vulnerary' | 'bow'} /><span>{item.name}</span><strong>{item.durability}</strong></li>)}
            {Array.from({ length: 3 }, () => <li class="item-row empty-slot" aria-hidden="true"><i></i></li>)}
          </ul>
          <h2 class="panel-heading">Skill Lv</h2>
          <CaiGraphic name="skillRanks" class="skill-ranks-graphic" label="Skill ranks shown in the supplied level 5 capture: Sword E+, Spear D, Axe E, Bow E, Brawling E, Reason E, Faith E+, Authority E, Infantry E, Riding E+, Armor E, Flying E." />
          <h2 class="panel-heading">Bloodmark</h2>
          <div class="item-row"><CaiGraphic name="apostle" /><span>{cai.bloodmarks[0]}</span></div>
          <div class="item-row"><CaiGraphic name="duality" /><span>{cai.bloodmarks[1]}</span></div>
        </div>
        <div class="panel-column ability-column">
          <h2 class="panel-heading">Personal Ability</h2>
          <div class="item-row"><CaiGraphic name="brio" /><span>{cai.personalAbility}</span></div>
          <h2 class="panel-heading">Class Abilities</h2>
          <ul class="slot-list" aria-label="No class abilities equipped">{Array.from({ length: 3 }, () => <li class="item-row empty-slot" aria-hidden="true"><i></i></li>)}</ul>
          <p class="all-empty">None</p>
          <h2 class="panel-heading">Equipped Abilities</h2>
          <ul class="slot-list"><li class="item-row"><CaiGraphic name="combatBasics" /><span>{cai.equippedAbility}</span></li>{Array.from({ length: 4 }, () => <li class="item-row empty-slot" aria-hidden="true"><i></i></li>)}</ul>
          <h2 class="panel-heading">Mounted Ability</h2>
          <div class="item-row empty-slot" aria-label="No mounted ability equipped"><i aria-hidden="true"></i><span class="all-empty">None</span></div>
        </div>
      </section>

      <section id="arts" class="character-screen arts-screen" role="tabpanel" aria-labelledby="tab-arts" tabindex="0" hidden>
        <header class="screen-heading"><h2 id="section-arts">Combat Arts &amp; Magic</h2></header>
        <div class="panel-column">
          <CaiIdentity />
          <h2 class="panel-heading">Combat Arts <span>Cost</span></h2>
          <div class="item-row"><CaiGraphic name="tempest" /><span>{cai.combatArt.name}</span><strong>{cai.combatArt.cost}</strong></div>
          <div class="item-row empty-slot round-slot" aria-hidden="true"><i></i></div><div class="item-row empty-slot round-slot" aria-hidden="true"><i></i></div>
        </div>
        <div class="panel-column">
          <h2 class="panel-heading">Attack Magic <span>Left:</span></h2>
          <div class="item-row empty-slot"><i aria-hidden="true"></i><span>None</span></div>
          <h2 class="panel-heading">Assist Magic <span>Left:</span></h2>
          <div class="item-row empty-slot"><i aria-hidden="true"></i><span>None</span></div>
        </div>
        <div class="panel-column decorative-column" aria-hidden="true"></div>
      </section>

      <section id="class" class="character-screen class-screen" role="tabpanel" aria-labelledby="tab-class" tabindex="0" hidden>
        <header class="screen-heading"><h2 id="section-class">Class</h2></header>
        <div class="class-top">
          <div class="panel-column"><CaiIdentity /></div>
          <div class="panel-column"><h2 class="panel-heading">Current Class Info</h2><p class="panel-copy">{cai.classDescription}</p></div>
          <div class="panel-column decorative-column" aria-hidden="true"></div>
        </div>
        <h2 class="panel-heading class-list-heading">Class List</h2>
        <div class="class-grid-scroll">
          <table class="character-class-table" aria-label="Cai's class list from the supplied capture">
            <colgroup><col class="class-tier-column" /><col /><col /><col class="soldier-column" /><col class="flier-column" /><col /></colgroup>
            <thead class="sr-only"><tr><th scope="col">Tier</th>{classLines.map((line) => <th scope="col">{line.name}</th>)}</tr></thead>
            <tbody>
              <tr class="base-class-row"><th scope="row">Base</th><td><CaiGraphic name="baseClass" class="base-class-graphic" label="Commoner, equipped" /><span class="class-family">Gladiators</span></td>{classLines.slice(1).map((line) => <td><span class="class-family">{line.name}</span></td>)}</tr>
              <tr><th scope="row">Beginner</th>{classLines.map((line) => <td><CaiGraphic name={line.beginner} class="class-sprite" label={line.beginner.charAt(0).toUpperCase() + line.beginner.slice(1)} /></td>)}</tr>
              <tr><th scope="row">Specialty</th>{classLines.map((line) => <td><CaiGraphic name={line.specialty} class="class-sprite-group" label={`${line.count} ${line.name.toLowerCase()} specialty class icons`} /></td>)}</tr>
              {Array.from({ length: 3 }, () => <tr class="empty-class-row" aria-hidden="true"><th></th>{classLines.map(() => <td></td>)}</tr>)}
            </tbody>
          </table>
        </div>
      </section>

      <section id="unique" class="character-screen unique-screen" role="tabpanel" aria-labelledby="tab-unique" tabindex="0" hidden>
        <header class="screen-heading"><h2 id="section-unique">Unique Abilities</h2></header>
        <div class="panel-column">
          <CaiIdentity />
          <h2 class="panel-heading">Blaze Type</h2>
          <div class="item-row"><CaiGraphic name="underworld" /><span>{cai.blaze.type}</span></div>
          <p class="panel-copy blaze-description">{cai.blaze.description}</p>
        </div>
        <div class="panel-column">
          <h2 class="panel-heading">Blaze Arts <span>HP Cost</span></h2>
          <div class="item-row"><CaiGraphic name="burst" /><span>{cai.blaze.art}</span><strong>{cai.blaze.hpCost}</strong></div>
        </div>
        <div class="panel-column">
          <h2 class="panel-heading">Source</h2>
          <div class="item-row"><CaiGraphic name="redJewel" /><span>{cai.blaze.source}</span></div>
          <p class="panel-copy jewel-description">{cai.blaze.sourceDescription}</p>
          <CaiGraphic name="jewel" class="jewel-graphic" label="Red Jewel: a red gemstone in a gold pendant and chain, surrounded by violet flames." />
        </div>
      </section>

      <section id="history" class="character-screen history-screen" role="tabpanel" aria-labelledby="tab-history" tabindex="0" hidden>
        <header class="screen-heading"><h2 id="section-history">Personal History</h2></header>
        <div class="panel-column history-identity">
          <CaiGraphic name="portrait" class="history-portrait" label="Cai, wearing a blue cloak and cream scarf." />
          <h2 class="panel-heading">Basic Information</h2>
          <dl class="personal-details"><div><dt>Birthday</dt><dd>{cai.birthday}</dd></div><div><dt>Age</dt><dd>{cai.age}</dd></div><div><dt>Height</dt><dd>{cai.height}</dd></div></dl>
          <div class="affiliation"><div><h2 class="panel-heading">Affiliation</h2><p>{cai.affiliation}</p></div><CaiGraphic name="crest" label="Children of Ribeira banner" /></div>
        </div>
        <div class="history-content">
          <table class="history-table" aria-label="Cai's personal history"><tbody>{cai.history.map((event) => <tr><th scope="row">{event.year}</th><td>{event.text}</td></tr>)}{Array.from({ length: 7 }, () => <tr class="empty-history-row" aria-hidden="true"><th></th><td></td></tr>)}</tbody></table>
          <div class="interests-grid"><div><h2 class="panel-heading">Likes</h2><p class="panel-copy">{cai.likes}</p><h2 class="panel-heading dislikes-heading">Dislikes</h2><p class="panel-copy">{cai.dislikes}</p></div><div><h2 class="panel-heading">Interests</h2><p class="panel-copy">{cai.interests}</p></div></div>
        </div>
      </section>
    </div>

    <nav class="panel-navigation" aria-label="Cai information">
      <button class="panel-arrow" type="button" data-direction="-1" aria-label="Previous panel" hidden><span aria-hidden="true">‹‹ <i>❖</i></span></button>
      <div class="panel-current"><span id="screen-name" aria-hidden="true">Stats</span><div class="panel-tabs" role="tablist" aria-label="Character information">{screens.map((screen, i) => <a id={`tab-${screen.id}`} href={`#${screen.id}`} role="tab" aria-controls={screen.id} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} title={screen.label}><span class="tab-diamond" aria-hidden="true">◆</span><span class="tab-label">{screen.label}</span></a>)}</div></div>
      <button class="panel-arrow" type="button" data-direction="1" aria-label="Next panel" hidden><span aria-hidden="true"><i>❖</i> ››</span></button>
    </nav>
  </article>
  <CaiReferenceStats />
  <noscript><style>.character-screen[hidden] { display: grid !important; } .character-screen { margin-bottom: 3rem; } .character-screens { height: auto; } .panel-tabs .tab-label { position: static; clip-path: none; width: auto; height: auto; } .panel-tabs { flex-wrap: wrap; } .panel-current { width: auto; }</style></noscript>
  <script>import '../../scripts/character-panel';</script>
</SiteLayout>
