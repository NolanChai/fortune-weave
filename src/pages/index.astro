---
import characterIndex from '../../assets/characters/index.json';
import birdTime from '../../data/bird-time.json';
import { characters as profiles } from '../data/characters';
import SiteLayout from '../layouts/SiteLayout.astro';
import '../styles/bird-time.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const profileIds = new Set(profiles.map(({ id }) => id));
const characters = birdTime.characters.map((character) => {
  const portrait = characterIndex.characters.find(({ id }) => id === character.id);
  if (!portrait) throw new Error(`Missing portrait for ${character.id}`);
  return { ...character, icon: `${base}/assets/characters/${portrait.icon}` };
});
---

<SiteLayout title="Bird Time" page="bird-time" description="Bird Time dialogue quotes and answers for Fire Emblem Fortune's Weave. Search every character on one page.">
      <div class="page-heading">
        <div class="page-intro">
          <h1>Bird Time</h1>
        </div>
        <div class="toolbar">
          <label class="search" id="search-control" hidden>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
            <circle cx="10.5" cy="10.5" r="6.5" />
            <path d="m16 16 4.5 4.5" />
          </svg>
          <input id="query" type="search" placeholder="Search…" aria-label="Search characters, quotes, or answers" autocomplete="off" />
          </label>
          <p class="sr-only" id="search-status" role="status" aria-live="polite" aria-atomic="true"></p>
        </div>
      </div>
      <div class="panels" id="bird-time">
        {characters.map((character, characterIndex) => (
          <section class="panel" data-character={character.name.toLowerCase()} aria-labelledby={`character-${character.id}-title`}>
            <header class="panel-header">
              <img class="portrait" src={character.icon} alt="" width={48} height={48} loading={characterIndex < 2 ? 'eager' : 'lazy'} decoding="async" />
              <div>
                <h2 class="character-name" id={`character-${character.id}-title`}>{profileIds.has(character.id) ? <a href={`${base}/characters/${character.id}/`}>{character.name}</a> : character.name}</h2>
              </div>
            </header>
            <ul class="entries">
              {character.entries.map((entry) => (
                <li class="entry" id={entry.id}>
                  <p class="quote">{entry.topic}</p>
                  <span class={entry.answer === null ? 'answer missing' : 'answer'}>
                    {entry.answer ?? 'Not listed in source'}
                  </span>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
      <p id="empty-results" class="empty" hidden>No matching characters or answers.</p>
    <script>
      import '../scripts/search';
    </script>
</SiteLayout>
