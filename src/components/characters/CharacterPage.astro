---
import SiteLayout from '../../layouts/SiteLayout.astro';
import CharacterGraphic from './CharacterGraphic.astro';
import CharacterIdentity from './CharacterIdentity.astro';
import StatChart from './StatChart.astro';
import PanelDecoration from './PanelDecoration.astro';
import CharacterReferenceStats from './CharacterReferenceStats.astro';
import CharacterRecommendations from './CharacterRecommendations.astro';
import buildData from '../../../data/character-builds.json';
import type { Character } from '../../data/characters';
interface Props { character: Character; }
const { character } = Astro.props;
const hasRecommendations = buildData.characters.some(({ characterId }) => characterId === character.id);
import '../../styles/characters.css';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const screens = [
  { id: 'stats', label: 'Stats' },
  { id: 'arts', label: 'C.Arts/Magic' },
  { id: 'class', label: 'Class' },
  ...(character.blaze ? [{ id: 'unique', label: 'Unique Abilities' }] : []),
  { id: 'history', label: 'Personal History' },
];
const classLines = [
  { name: 'Gladiators', beginner: 'gladiator', className: 'Gladiator', specialty: 'gladiators', count: 3 },
  { name: 'Hunters', beginner: 'hunter', className: 'Hunter', specialty: 'hunters', count: 2 },
  { name: 'Soldiers', beginner: 'soldier', className: 'Soldier', specialty: 'soldiers', count: 3 },
  { name: 'Fliers', beginner: 'flier', className: 'Ornius Rider', specialty: 'fliers', count: character.flierSpecialties },
  { name: 'Mages', beginner: 'mage', className: 'Diviner', specialty: 'mages', count: 2 },
] as const;
const marks: Record<string, string> = { sword: '⚔', shield: '⛨', speed: '≋', resistance: '♧', dexterity: '☼', luck: '✦', charm: '♡', spear: '↗', book: '▱' };
---
<SiteLayout title={character.name} page="characters" character canonicalPath={`/characters/${character.id}/`} description={`${character.name}, ${character.title}. Stats, combat arts, class, and personal history.`}>
  <div class="character-toolbar">
    <a class="back-to-characters" href={`${base}/characters/`}><span aria-hidden="true">‹</span> Characters</a>
    <div class="view-switch" role="group" aria-label="Character layout" hidden>
      <button type="button" data-character-view="panels" aria-pressed="true">Panels</button>
      <button type="button" data-character-view="all" aria-pressed="false">All information</button>
    </div>
  </div>
  <article class="character-panel" data-view="panels" aria-labelledby="character-name">
    <div class="panel-surface" aria-hidden="true"><PanelDecoration /></div>
    <svg class="panel-frame" viewBox="0 0 1840 980" preserveAspectRatio="none" fill="none" aria-hidden="true"><path d="M2 31H438L468 2H1372L1402 31H1838V978H2Z" /><path d="M9 39H441L472 10H1368L1399 39H1831V970H9Z" /></svg>
    <header class="character-title"><h1 id="character-name">{character.name} <span>{character.title}</span></h1></header>
    <nav class="all-section-nav" aria-label={`${character.name} sections`} hidden>
      {screens.map((screen) => <a href={`#${screen.id}`}>{screen.id === 'arts' ? 'Arts & Magic' : screen.label}</a>)}
      {character.referenceStats && <a href="#starting-stats">{character.referenceStats.baseSource ? 'Starting stats & growth' : 'Growth rates'}</a>}
      {hasRecommendations && <a href="#class-recommendations">Class recommendations</a>}
    </nav>

    <div class="character-screens">
      <section id="stats" class="character-screen stats-screen" role="tabpanel" aria-labelledby="tab-stats" tabindex="0">
        <header class="screen-heading"><h2 id="section-stats">Stats</h2><span>Lv. {character.level} capture</span></header>
        <div class="panel-column">
          <CharacterIdentity character={character} />
          <div class="stat-section">
            <h2 class="panel-heading">Combat Stats</h2>
            <div class="stat-block">
              <dl class="stat-values">{character.combatStats.map((stat) => <div><dt><span class="stat-symbol" aria-hidden="true">{marks[stat.icon]}</span>{stat.name}</dt><dd class:list={{ boosted: stat.boosted }}>{stat.value}{stat.boosted && <sup>▴</sup>}</dd></div>)}</dl>
              <StatChart characterId={character.id} type="combat" />
            </div>
          </div>
          <div class="stat-section">
            <h2 class="panel-heading">Basic Stats <span class="rating">Rating <strong class:list={{ boosted: character.ratingBoosted }}>{character.rating}{character.ratingBoosted && <sup>▴</sup>}</strong></span></h2>
            <div class="stat-block">
              <dl class="stat-values">{character.basicStats.map((stat) => <div><dt><span class="stat-symbol" aria-hidden="true">{marks[stat.icon]}</span>{stat.name}</dt><dd class:list={{ boosted: stat.boosted }}>{stat.value}{stat.boosted && <sup>▴</sup>}</dd></div>)}</dl>
              <StatChart characterId={character.id} type="basic" />
            </div>
          </div>
        </div>
        <div class="panel-column">
          <h2 class="panel-heading">Equipped <span>Durability</span></h2>
          <div class="item-row"><CharacterGraphic characterId={character.id} name={character.equipped.graphic} /><span>{character.equipped.name}</span><strong>{character.equipped.durability}</strong></div>
          <h2 class="panel-heading">Items <span>Durability</span></h2>
          <ul class="slot-list items">
            {character.items.map((item) => <li class:list={['item-row', { 'inactive-item': item.inactive }]}><CharacterGraphic characterId={character.id} name={item.graphic} /><span>{item.name}</span><strong>{item.durability}</strong></li>)}
            {Array.from({ length: Math.max(0, 6 - character.items.length) }, () => <li class="item-row empty-slot" aria-hidden="true"><i></i></li>)}
          </ul>
          {character.items.length === 0 && <p class="all-empty">None</p>}
          <h2 class="panel-heading">Skill Lv</h2>
          <CharacterGraphic characterId={character.id} name="skillRanks" class="skill-ranks-graphic" label={character.skillRanksDescription} />
          {character.bloodmarks.length > 0 && <>
            <h2 class="panel-heading">Bloodmark</h2>
            {character.bloodmarks.map((mark) => <div class="item-row"><CharacterGraphic characterId={character.id} name={mark.graphic} /><span>{mark.name}</span></div>)}
          </>}
        </div>
        <div class="panel-column ability-column">
          <h2 class="panel-heading">Personal Ability</h2>
          <div class="item-row"><CharacterGraphic characterId={character.id} name="personalAbility" /><span>{character.personalAbility}</span></div>
          <h2 class="panel-heading">Class Abilities</h2>
          <ul class="slot-list" aria-label="No class abilities equipped">{Array.from({ length: 3 }, () => <li class="item-row empty-slot" aria-hidden="true"><i></i></li>)}</ul>
          <p class="all-empty">None</p>
          <h2 class="panel-heading">Equipped Abilities</h2>
          <ul class="slot-list" aria-label={character.equippedAbility ? undefined : 'No abilities equipped'}>
            {character.equippedAbility && <li class="item-row"><CharacterGraphic characterId={character.id} name="equippedAbility" /><span>{character.equippedAbility}</span></li>}
            {Array.from({ length: character.equippedAbility ? 4 : 5 }, () => <li class="item-row empty-slot" aria-hidden="true"><i></i></li>)}
          </ul>
          {!character.equippedAbility && <p class="all-empty">None</p>}
          <h2 class="panel-heading">Mounted Ability</h2>
          <div class="item-row empty-slot" aria-label="No mounted ability equipped"><i aria-hidden="true"></i><span class="all-empty">None</span></div>
        </div>
      </section>

      <section id="arts" class="character-screen arts-screen" role="tabpanel" aria-labelledby="tab-arts" tabindex="0" hidden>
        <header class="screen-heading"><h2 id="section-arts">Combat Arts &amp; Magic</h2></header>
        <div class="panel-column">
          <CharacterIdentity character={character} />
          <h2 class="panel-heading">Combat Arts <span>Cost</span></h2>
          {character.combatArts.map((art) => <div class="item-row"><CharacterGraphic characterId={character.id} name={art.graphic} /><span>{art.name}</span><strong>{art.cost}</strong></div>)}
          {Array.from({ length: Math.max(0, 3 - character.combatArts.length) }, () => <div class="item-row empty-slot round-slot" aria-hidden="true"><i></i></div>)}
          {character.combatArts.length === 0 && <p class="all-empty">None</p>}
        </div>
        <div class="panel-column">
          <h2 class="panel-heading">Attack Magic <span>Left:</span></h2>
          {character.attackMagic.length ? character.attackMagic.map((spell) => <div class="item-row"><CharacterGraphic characterId={character.id} name={spell.graphic} /><span>{spell.name}</span><strong>{spell.durability}</strong></div>) : <div class="item-row empty-slot"><i aria-hidden="true"></i><span>None</span></div>}
          <h2 class="panel-heading">Assist Magic <span>Left:</span></h2>
          {character.assistMagic.length ? character.assistMagic.map((spell) => <div class="item-row"><CharacterGraphic characterId={character.id} name={spell.graphic} /><span>{spell.name}</span><strong>{spell.durability}</strong></div>) : <div class="item-row empty-slot"><i aria-hidden="true"></i><span>None</span></div>}
        </div>
        <div class="panel-column decorative-column" aria-hidden="true"></div>
      </section>

      <section id="class" class="character-screen class-screen" role="tabpanel" aria-labelledby="tab-class" tabindex="0" hidden>
        <header class="screen-heading"><h2 id="section-class">Class</h2></header>
        <div class="class-top">
          <div class="panel-column"><CharacterIdentity character={character} /></div>
          <div class="panel-column"><h2 class="panel-heading">Current Class Info</h2><p class="panel-copy">{character.classDescription}</p>{character.classMasteryPoints !== undefined && <p class="panel-copy">Points to Master: {character.classMasteryPoints}</p>}</div>
          <div class="panel-column decorative-column" aria-hidden="true"></div>
        </div>
        <h2 class="panel-heading class-list-heading">Class List</h2>
        <div class="class-grid-scroll">
          <table class="character-class-table" aria-label={`${character.name}’s class list from the supplied capture`}>
            <colgroup><col class="class-tier-column" /><col /><col /><col class="soldier-column" /><col class="flier-column" /><col /></colgroup>
            <thead class="sr-only"><tr><th scope="col">Tier</th>{classLines.map((line) => <th scope="col">{line.name}</th>)}</tr></thead>
            <tbody>
              <tr class="base-class-row"><th scope="row">Base</th><td><CharacterGraphic characterId={character.id} name="baseClass" class="base-class-graphic" label={`Commoner${character.class === 'Commoner' ? ', equipped' : ''}`} /><span class="class-family">Gladiators</span></td>{classLines.slice(1).map((line) => <td><span class="class-family">{line.name}</span></td>)}</tr>
              <tr><th scope="row">Beginner</th>{classLines.map((line) => <td>{(!character.capturedClassIcons || character.capturedClassIcons.beginner.includes(line.beginner)) && <CharacterGraphic characterId={character.id} name={line.beginner} class="class-sprite" label={`${line.className}${character.class === line.className ? ', equipped' : ''}`} />}</td>)}</tr>
              <tr><th scope="row">Specialty</th>{classLines.map((line) => {
                const count = character.capturedClassIcons ? character.capturedClassIcons.specialty[line.specialty] ?? 0 : line.count;
                return <td>{count > 0 && <CharacterGraphic characterId={character.id} name={line.specialty} class="class-sprite-group" label={`${count} ${line.name.toLowerCase()} specialty class icons`} />}</td>;
              })}</tr>
              {Array.from({ length: 3 }, () => <tr class="empty-class-row" aria-hidden="true"><th></th>{classLines.map(() => <td></td>)}</tr>)}
            </tbody>
          </table>
        </div>
      </section>

      {character.blaze && <section id="unique" class="character-screen unique-screen" role="tabpanel" aria-labelledby="tab-unique" tabindex="0" hidden>
        <header class="screen-heading"><h2 id="section-unique">Unique Abilities</h2></header>
        <div class="panel-column">
          <CharacterIdentity character={character} />
          <h2 class="panel-heading">Blaze Type</h2>
          <div class="item-row"><CharacterGraphic characterId={character.id} name="underworld" /><span>{character.blaze.type}</span></div>
          <p class="panel-copy blaze-description">{character.blaze.description}</p>
        </div>
        <div class="panel-column">
          <h2 class="panel-heading">Blaze Arts <span>HP Cost</span></h2>
          <div class="item-row"><CharacterGraphic characterId={character.id} name="burst" /><span>{character.blaze.art}</span><strong>{character.blaze.hpCost}</strong></div>
        </div>
        <div class="panel-column">
          <h2 class="panel-heading">Source</h2>
          <div class="item-row"><CharacterGraphic characterId={character.id} name="redJewel" /><span>{character.blaze.source}</span></div>
          <p class="panel-copy jewel-description">{character.blaze.sourceDescription}</p>
          <CharacterGraphic characterId={character.id} name="jewel" class="jewel-graphic" label="Red Jewel: a red gemstone in a gold pendant and chain, surrounded by violet flames." />
        </div>
      </section>}

      <section id="history" class="character-screen history-screen" role="tabpanel" aria-labelledby="tab-history" tabindex="0" hidden>
        <header class="screen-heading"><h2 id="section-history">Personal History</h2></header>
        <div class="panel-column history-identity">
          <CharacterGraphic characterId={character.id} name="portrait" class="history-portrait" label={character.portraitDescription} />
          <h2 class="panel-heading">Basic Information</h2>
          <dl class="personal-details"><div><dt>Birthday</dt><dd>{character.birthday}</dd></div><div><dt>Age</dt><dd>{character.age}</dd></div><div><dt>Height</dt><dd>{character.height}</dd></div></dl>
          <div class="affiliation"><div><h2 class="panel-heading">Affiliation</h2><p>{character.affiliation}</p></div><CharacterGraphic characterId={character.id} name="crest" label={`${character.affiliation} banner`} /></div>
        </div>
        <div class="history-content">
          <table class="history-table" aria-label={`${character.name}’s personal history`}><tbody>{character.history.map((event) => <tr><th scope="row">{event.year}</th><td>{event.text}</td></tr>)}{Array.from({ length: Math.max(0, 10 - character.history.length) }, () => <tr class="empty-history-row" aria-hidden="true"><th></th><td></td></tr>)}</tbody></table>
          <div class="interests-grid"><div><h2 class="panel-heading">Likes</h2><p class="panel-copy">{character.likes}</p><h2 class="panel-heading dislikes-heading">Dislikes</h2><p class="panel-copy">{character.dislikes}</p></div><div><h2 class="panel-heading">Interests</h2><p class="panel-copy">{character.interests}</p></div></div>
        </div>
      </section>
    </div>

    <nav class="panel-navigation" aria-label={`${character.name} information`}>
      <button class="panel-arrow" type="button" data-direction="-1" aria-label="Previous panel" hidden><span aria-hidden="true">‹‹ <i>❖</i></span></button>
      <div class="panel-current"><span id="screen-name" aria-hidden="true">Stats</span><div class="panel-tabs" role="tablist" aria-label="Character information">{screens.map((screen, i) => <a id={`tab-${screen.id}`} href={`#${screen.id}`} role="tab" aria-controls={screen.id} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} title={screen.label}><span class="tab-diamond" aria-hidden="true">◆</span><span class="tab-label">{screen.label}</span></a>)}</div></div>
      <button class="panel-arrow" type="button" data-direction="1" aria-label="Next panel" hidden><span aria-hidden="true"><i>❖</i> ››</span></button>
    </nav>
  </article>
  {character.referenceStats && <CharacterReferenceStats stats={character.referenceStats} captureLevel={character.level} />}
  {hasRecommendations && <CharacterRecommendations character={character} />}
  <noscript><style>.character-screen[hidden] { display: grid !important; } .character-screen { margin-bottom: 3rem; } .character-screens { height: auto; } .panel-tabs .tab-label { position: static; clip-path: none; width: auto; height: auto; } .panel-tabs { flex-wrap: wrap; } .panel-current { width: auto; }</style></noscript>
  <script>import '../../scripts/character-panel';</script>
</SiteLayout>
