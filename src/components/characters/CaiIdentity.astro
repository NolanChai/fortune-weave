---
import cai from '../../../data/characters/cai.json';
import CaiGraphic from './CaiGraphic.astro';
---
<div class="identity-card">
  <CaiGraphic name="identityPortrait" label="Cai" class="identity-portrait" />
  <div class="identity-content">
    <div class="identity-class"><CaiGraphic name="commoner" /><span>{cai.class}</span><CaiGraphic name="foot" class="foot-mark" /></div>
    <dl class="identity-stats">
      <div class="hp"><dt>HP</dt><dd>{cai.hp}<span>/</span>{cai.maxHp}</dd></div>
      <div class="level"><dt>Lv</dt><dd>{cai.level}</dd></div>
      <div class="next"><dt>Next:</dt><dd>{cai.nextLevel}</dd></div>
      <div class="experience" aria-label="10 experience out of 100"><span></span></div>
      <div class="movement"><dt>Mov</dt><dd class="boosted">{cai.movement}<sup>▴</sup></dd></div>
      <div class="build"><dt>Bld</dt><dd>{cai.build}</dd></div>
    </dl>
  </div>
</div>
