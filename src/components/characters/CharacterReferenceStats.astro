---
import { HIGH_GROWTH_RATE, type Character } from '../../data/characters';
interface Props { stats: NonNullable<Character['referenceStats']>; captureLevel: number; }
const { stats, captureLevel } = Astro.props;
---
<section class="reference-stats" id="starting-stats" aria-labelledby="reference-stats-title" tabindex="-1">
  <h2 id="reference-stats-title">Starting stats &amp; growth rates</h2>
  <p class="reference-context">Lv. {stats.level} {stats.class}<span aria-hidden="true"> · </span>Mov {stats.movement}{stats.movementBonus && <> +{stats.movementBonus} ({stats.movementBonusAbility})</>}<span aria-hidden="true"> · </span>Bld {stats.build}</p>
  <div class="reference-table-scroll" role="region" aria-label="Starting stats and growth rates table" tabindex="0">
    <table class="reference-table">
      <thead><tr><th scope="col">Stat</th>{stats.values.map((stat) => <th scope="col">{stat.name}</th>)}</tr></thead>
      <tbody>
        <tr><th scope="row">Starting</th>{stats.values.map((stat) => <td>{stat.base}</td>)}</tr>
        <tr><th scope="row">Growth</th>{stats.values.map((stat) => <td>{stat.growth >= HIGH_GROWTH_RATE ? <strong class="high-growth" title={`High growth: ${HIGH_GROWTH_RATE}% or higher`}>{stat.growth}%</strong> : `${stat.growth}%`}</td>)}</tr>
      </tbody>
    </table>
  </div>
  <p class="reference-note"><strong class="high-growth">Bold gold: {HIGH_GROWTH_RATE}%+.</strong> Reported personal growths exclude class bonuses. Panels show the Lv. {captureLevel} save.</p>
  <p class="reference-sources">Starting stats: <a href={stats.baseSource.url}>{stats.baseSource.name}</a><span aria-hidden="true"> · </span>Growth rates: <a href={stats.growthSource.url}>{stats.growthSource.name}</a></p>
</section>
