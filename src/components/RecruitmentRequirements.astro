---
import recruitment from '../../data/recruitment.json';
interface Props {
  characterId: string;
  characterName: string;
  heading?: 'h2' | 'h3' | 'h4';
  showSources?: boolean;
}
const { characterId, characterName, heading: Heading = 'h3', showSources = false } = Astro.props;
const character = recruitment.characters.find(({ id }) => id === characterId);
const rows = (character?.requirements ?? []).map((row) => ({ ...row, note: 'note' in row ? row.note : '' }));
const routeNames = new Map(recruitment.routes.map(({ id, name }) => [id, name]));
---
<div class="recruitment" data-recruitment>
  <Heading class="recruitment-heading">Recruitment <span>Part I</span></Heading>
  {rows.length > 0 ? <table class="recruitment-table" aria-label={`${characterName} recruitment requirements`}>
    <thead><tr><th scope="col">Route</th><th scope="col">Support</th><th scope="col">Renown</th></tr></thead>
    {rows.map((row) => <tbody data-recruitment-route={row.routeId}>
      <tr>
        <th scope="row">{routeNames.get(row.routeId)}</th>
        {row.status === 'recruit' ? <>
          <td>{row.support === null ? <span class="requirement-unknown">Unverified</span> : <strong>{row.support}</strong>}</td>
          <td>{row.renown === null ? <span class="requirement-unknown">Unverified</span> : <strong>{row.renown}</strong>}</td>
        </> : <td colspan="2" class="recruitment-status">{row.status === 'automatic' ? 'Automatic' : 'Unavailable'}</td>}
      </tr>
      {(row.conditions || row.note) && <tr><td colspan="3" class="recruitment-condition">
        {row.conditions && <span>{row.conditions}</span>}
        {row.note && <span class="requirement-unknown">{row.note}</span>}
      </td></tr>}
    </tbody>)}
  </table> : <p class="recruitment-note">{character?.partOneRoutes === null ? 'Recruitment requirements are not documented yet.' : character?.note ?? 'Recruitment requirements are not documented yet.'}</p>}
  {showSources && <p class="recruitment-sources">Support is with the route’s lord. Sources: {recruitment.sources.map((source, i) => <>{i > 0 && ', '}<a href={source.url}>{source.name.replace(' recruitment guide', '')}</a></>)}.</p>}
</div>

<style>
  .recruitment { min-width: 0; font: 14px/1.5 -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; text-shadow: none; }
  .recruitment-heading { display: flex; align-items: baseline; gap: 12px; margin: 0 0 8px; color: var(--text); font: 20px/1.3 Georgia, serif; }
  .recruitment-heading span { color: var(--secondary); font: 11px/1.5 -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; }
  .recruitment-table { width: 100%; border-collapse: collapse; table-layout: fixed; text-align: left; }
  .recruitment-table th, .recruitment-table td { padding: 7px 8px; }
  .recruitment-table th:first-child { width: 40%; padding-left: 0; }
  .recruitment-table thead { border-bottom: 1px solid #b7ae7787; color: var(--secondary); font-size: 12px; }
  .recruitment-table th { font-weight: 400; }
  .recruitment-table tbody { border-bottom: 1px solid #b7ae7740; }
  .recruitment-table strong { color: #f3d58d; font-weight: 600; font-variant-numeric: tabular-nums; }
  .recruitment-table .recruitment-condition { padding: 0 0 9px; color: var(--secondary); font-size: 12px; }
  .recruitment-condition span { display: block; }
  .recruitment-status, .recruitment-note { color: var(--secondary); }
  .requirement-unknown { color: #d5c593; font-size: 12px; }
  .recruitment-sources { margin: 12px 0 0; color: var(--secondary); font-size: 12px; }
  .recruitment-sources a { color: inherit; }
</style>
